{
    "name": "lunarphp/lunar-minic",
    "description": "Custom minic fork of Lunar package",
    "license": "MIT",
    "authors": [
        {
            "name": "Lunar",
            "homepage": "https://lunarphp.io/"
        }
    ],
    "require": {
        "awcodes/filament-badgeable-column": "^v3.0.0-beta.1",
        "awcodes/shout": "^v3.0.0-beta.2",
        "barryvdh/laravel-dompdf": "^3.0",
        "dompdf/dompdf": "^3.1",
        "ext-bcmath": "*",
        "ext-exif": "*",
        "ext-intl": "*",
        "filament/filament": "^4.1",
        "filament/spatie-laravel-media-library-plugin": "^4.0",
        "guzzlehttp/guzzle": "^7.3",
        "http-interop/http-factory-guzzle": "^1.2",
        "lunarphp/nestedset": "^1.0",
        "laravel/framework": "^12.0|^13.0",
        "laravel/scout": "^10.13.1",
        "leandrocfe/filament-apex-charts": "^5.0",
        "livewire/livewire": "^3.0",
        "lukascivil/treewalker": "0.9.1",
        "lunarphp/lunar": "self.version",
        "meilisearch/meilisearch-php": "^1.10",
        "minic/laravel-ai-assistant": "^1.0.0",
        "saloonphp/saloon": "^4.0",
        "php": "^8.3",
        "spatie/laravel-activitylog": "^4.10.1",
        "spatie/laravel-blink": "^1.7.1",
        "spatie/laravel-data": "^4.13.1",
        "spatie/laravel-medialibrary": "^11.12.7",
        "spatie/laravel-permission": "^6.12",
        "spatie/php-structure-discoverer": "^2.3.1",
        "stripe/stripe-php": "^16.0",
        "technikermathe/blade-lucide-icons": "^v3.0",
        "typesense/typesense-php": "^4.9"
    },
    "require-dev": {
        "filament/upgrade": "^4.0",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "1.29.0",
        "mockery/mockery": "^1.6.9",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1.17",
        "spatie/guidelines-skills": "^1.0",
        "symplify/monorepo-builder": "^11.0"
    },
    "autoload": {
        "files": [
            "packages/admin/src/helpers.php",
            "packages/core/src/helpers.php",
            "packages/search/src/helpers.php"
        ],
        "psr-4": {
            "Lunar\\": "packages/core/src",
            "Lunar\\Admin\\": "packages/admin/src/",
            "Lunar\\Admin\\Database\\Factories\\": "packages/admin/database/factories",
            "Lunar\\Admin\\Database\\State\\": "packages/admin/database/state",
            "Lunar\\Blog\\": "packages/blog/src",
            "Lunar\\Blog\\Database\\Factories\\": "packages/blog/database/factories",
            "Lunar\\Blog\\Database\\Seeders\\": "packages/blog/database/seeders",
            "Lunar\\Database\\Factories\\": "packages/core/database/factories",
            "Lunar\\Database\\Seeders\\": "packages/core/database/seeders",
            "Lunar\\Database\\State\\": "packages/core/database/state",
            "Lunar\\ERP\\": "packages/ERP/src/",
            "Lunar\\Klaviyo\\": "packages/klaviyo/src/",
            "Lunar\\Locations\\Database\\Seeders\\": "packages/locations/database/seeders",
            "Lunar\\Loyalty\\": "packages/loyalty/src",
            "Lunar\\Loyalty\\Database\\Factories\\": "packages/loyalty/database/factories",
            "Lunar\\Loyalty\\Database\\State\\": "packages/loyalty/database/state",
            "Lunar\\Mailchimp\\": "packages/mailchimp/src/",
            "Lunar\\Meilisearch\\": "packages/meilisearch/src/",
            "Lunar\\Opayo\\": "packages/opayo/src/",
            "Lunar\\Paypal\\": "packages/paypal/src/",
            "Lunar\\Review\\": "packages/review/src",
            "Lunar\\Review\\Database\\Factories\\": "packages/review/database/factories",
            "Lunar\\Review\\Database\\Seeders\\": "packages/review/database/seeders",
            "Lunar\\Review\\Database\\State\\": "packages/review/database/state",
            "Lunar\\Locations\\": "packages/locations/src/",
            "Lunar\\Search\\": "packages/search/src/",
            "Lunar\\Addons\\Shipping\\": "packages/shipping/src",
            "Lunar\\Shipping\\": "packages/table-rate-shipping/src",
            "Lunar\\Shipping\\Database\\Factories\\": "packages/table-rate-shipping/database/factories",
            "Lunar\\Shipping\\Database\\State\\": "packages/table-rate-shipping/database/state",
            "Lunar\\Content\\": "packages/content/src",
            "Lunar\\Stripe\\": "packages/stripe/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Lunar\\Tests\\": "tests",
            "Lunar\\Tests\\Admin\\": "tests/admin",
            "Lunar\\Tests\\Core\\": "tests/core",
            "Lunar\\Tests\\Opayo\\": "tests/opayo",
            "Lunar\\Tests\\Paypal\\": "tests/paypal",
            "Lunar\\Tests\\Shipping\\": "tests/shipping",
            "Lunar\\Shipping\\Tests\\": "packages/table-rate-shipping/tests",
            "Lunar\\Tests\\Stripe\\": "tests/stripe",
            "Lunar\\Tests\\Search\\": "tests/search",
            "Lunar\\Tests\\Blog\\": "tests/blog",
            "Lunar\\Tests\\ERP\\": "tests/ERP",
            "Lunar\\Tests\\Review\\": "tests/review",
            "Lunar\\Tests\\ShippingAddon\\": "tests/shipping-addon",
            "Lunar\\Tests\\Klaviyo\\": "tests/klaviyo",
            "Lunar\\Tests\\Loyalty\\": "tests/loyalty",
            "Lunar\\Tests\\Mailchimp\\": "tests/mailchimp"
        }
    },
    "extra": {
        "lunar": {
            "name": [
                "Blog",
                "ERP",
                "Klaviyo",
                "Mailchimp",
                "Locations",
                "Loyalty",
                "Review",
                "Table Rate Shipping",
                "Shipping",
                "Opayo Payments",
                "Search",
                "Meilisearch",
                "Paypal Payments",
                "Stripe Payments"
            ]
        },
        "laravel": {
            "providers": [
                "Lunar\\Stripe\\StripePaymentsServiceProvider",
                "Lunar\\Paypal\\PaypalServiceProvider",
                "Lunar\\Meilisearch\\MeilisearchServiceProvider",
                "Lunar\\Search\\SearchServiceProvider",
                "Lunar\\Admin\\LunarPanelProvider",
                "Lunar\\Opayo\\OpayoServiceProvider",
                "Lunar\\Addons\\Shipping\\ShippingServiceProvider",
                "Lunar\\Shipping\\ShippingServiceProvider",
                "Lunar\\Locations\\LocationsServiceProvider",
                "Lunar\\ERP\\ErpServiceProvider",
                "Lunar\\Review\\ReviewServiceProvider",
                "Lunar\\Loyalty\\LoyaltyServiceProvider",
                "Lunar\\Blog\\BlogServiceProvider",
                "Lunar\\Content\\ContentServiceProvider",
                "Lunar\\Mailchimp\\MailchimpServiceProvider",
                "Lunar\\Klaviyo\\KlaviyoServiceProvider",
                "Lunar\\LunarServiceProvider"
            ]
        }
    },
    "replace": {
        "lunarphp/blog": "self.version",
        "lunarphp/core": "self.version",
        "lunarphp/lunar": "self.version",
        "lunarphp/meilisearch": "self.version",
        "lunarphp/opayo": "self.version",
        "lunarphp/paypal": "self.version",
        "lunarphp/review": "self.version",
        "lunarphp/search": "self.version",
        "lunarphp/shipping": "self.version",
        "lunarphp/erp": "self.version",
        "lunarphp/locations": "self.version",
        "lunarphp/stripe": "self.version",
        "lunarphp/table-rate-shipping": "self.version",
        "lunarphp/klaviyo": "self.version",
        "lunarphp/loyalty": "self.version",
        "lunarphp/mailchimp": "self.version"
    },
    "scripts": {
        "pint": "pint",
        "test:pest": "pest",
        "test:phpstan": "phpstan analyse",
        "test": [
            "@test:pest",
            "@test:phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "laravel-ai-assistant": {
            "type": "git",
            "url": "git@github.com:minicstudio/laravel-ai-assistant.git"
        }
    }
}
